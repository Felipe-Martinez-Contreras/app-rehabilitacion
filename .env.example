# Copia este archivo como ".env" en la VM y completa los valores.
# El archivo .env no se sube al repositorio (está en .gitignore y en .dockerignore).

# Token del túnel de Cloudflare (panel de Cloudflare → Zero Trust → Networks → Tunnels).
# Es un secreto: quien lo tenga puede conectar un túnel a tu cuenta.
TUNNEL_TOKEN=

# Solo para la alternativa con cloudflared instalado fuera de Docker
# (docker-compose.puerto-local.yml): puerto de 127.0.0.1 donde queda la app.
PUERTO_LOCAL=8080
